# 拾忆 · Recall Coach 环境变量样例：复制为 .env 后按需修改。
# 核心闭环不需要任何模型 API 密钥；本文件刻意不包含模型密钥项。

# ---------------- 应用侧 ----------------
# PowerContext 服务地址（记忆读写唯一入口）
POWERCONTEXT_URL=http://127.0.0.1:8777
# 服务端启用鉴权时填写；本机默认无需 token
POWERCONTEXT_TOKEN=
# SDK 请求超时（秒）
POWERCONTEXT_TIMEOUT=8

# 本地映射与答题流水（不存放学习记忆）
RECALL_DATA_DIR=data/runtime
# 操作留痕目录（powercontext-operations.jsonl）
RECALL_LOG_DIR=var/log

APP_HOST=127.0.0.1
APP_PORT=8642

# ---------------- PowerContext Server 侧 ----------------
# 数据目录：记忆持久化位置，必须放在持久卷上
POWERCONTEXT_HOME=.powercontext
POWERCONTEXT_SERVER_HTTP_PORT=8777

# ---------------- 验收脚本可选覆盖 ----------------
# 指定浏览器验收使用的 Chromium（默认复用本机 Playwright 缓存）
# RECALL_CHROMIUM=/home/xy/.cache/ms-playwright/chromium-1194/chrome-linux/chrome
# ACCEPTANCE_LEARNER=acceptance-demo
